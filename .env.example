# Copia a .env.local para desarrollo. No se necesita nada para funcionar en local/Vercel.
# Base del API oficial del Ministerio (MITERD). No cambiar salvo que el Ministerio migre de dominio.
MITERD_BASE_URL=https://sedeaplicaciones.minetur.gob.es/ServiciosRESTCarburantes/PreciosCarburantes/
# Tiempo de caché en segundos (s-maxage). 900 = 15 min.
CACHE_S_MAXAGE=900
